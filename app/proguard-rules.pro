# ---------------------------------------------------------------------------
# Room
#
# Room 用反射按「数据库类名 + _Impl」查找生成的实现类，R8 无法静态看到这层关系，
# 因此必须把数据库类本身和生成的实现类都保留下来。
# ---------------------------------------------------------------------------
-keep class * extends androidx.room.RoomDatabase { <init>(); }
-keep class com.hpcalc.core.data.**_Impl { *; }
-keepclassmembers class com.hpcalc.core.data.** {
    @androidx.room.* <methods>;
}

# ---------------------------------------------------------------------------
# Compose
#
# Compose 的运行时不需要额外规则；这里只保留 @Composable 函数的参数名信息，
# 让线上崩溃栈仍然可读。
# ---------------------------------------------------------------------------
-keepattributes SourceFile,LineNumberTable

# ---------------------------------------------------------------------------
# 数学库
#
# big-math 没有反射，但它出现在求值热路径上；保留名字便于定位问题。
# ---------------------------------------------------------------------------
-keepnames class ch.obermuhlner.math.big.** { *; }